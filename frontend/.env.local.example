# このファイルをコピーして .env.local を作成する（.env.local はコミットしないこと）
# Cognito の値は infra/ の `cdk deploy` 後に表示される Outputs から設定する。

# Outputs: CognitoUserPoolId / CognitoUserPoolClientId
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=your-cognito-app-client-id
# Outputs: CognitoDomain（Google ログインに使う）
NEXT_PUBLIC_COGNITO_DOMAIN=sparlog-dev.auth.ap-northeast-1.amazoncognito.com

# このフロントエンドのオリジン（cdk.json の frontendOrigins に含めること）
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
