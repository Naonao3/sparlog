# このファイルをコピーして .env を作成する（.env はコミットしないこと）
NODE_ENV=development
PORT=8080

# Supabase
# Settings > API > JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Settings > Database > Connection string（Session mode / port 5432）
DATABASE_URL=postgresql://postgres:[password]@db.xxx.supabase.co:5432/postgres

# アカウント削除時に auth.users も消す場合のみ設定（任意）
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=sparlog-videos
R2_PUBLIC_DOMAIN=https://xxx.r2.dev

# 署名付きURLの有効期限（秒）・アップロード上限（バイト）
UPLOAD_URL_EXPIRES_IN=900
PLAYBACK_URL_EXPIRES_IN=3600
MAX_UPLOAD_BYTES=2147483648

# CORS 許可オリジン（カンマ区切り）
CORS_ORIGINS=http://localhost:3000
