# このファイルをコピーして .env を作成する（.env はコミットしないこと）
# AWS 側の値は infra/ の `cdk deploy` 後に表示される Outputs から設定する。
NODE_ENV=development
PORT=8080

# PostgreSQL（ローカルの Postgres か、RDS の接続情報 Secrets Manager: sparlog/<env>/database）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sparlog

# AWS の認証情報はここに書かない（ローカルは AWS_PROFILE / aws sso login、ECS はタスクロール）
AWS_REGION=ap-northeast-1
# AWS_PROFILE=sparlog-dev

# Cognito（Outputs: CognitoUserPoolId / CognitoUserPoolClientId）
COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-cognito-app-client-id

# S3（Outputs: VideoBucketName）
S3_BUCKET_NAME=your-video-bucket-name

# CloudFront（Outputs: MediaDistributionDomain / CloudFrontKeyPairId）
CLOUDFRONT_DOMAIN=dxxxxxxxxxxxxx.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=KXXXXXXXXXXXXX
# 秘密鍵（infra/keys/<env>-cloudfront-private.pem の中身）。改行は \n で書いてよい
CLOUDFRONT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# 署名付きURLの有効期限（秒）・アップロード上限（バイト）
UPLOAD_URL_EXPIRES_IN=900
PLAYBACK_URL_EXPIRES_IN=3600
MAX_UPLOAD_BYTES=2147483648

# CORS 許可オリジン（カンマ区切り）
CORS_ORIGINS=http://localhost:3000
